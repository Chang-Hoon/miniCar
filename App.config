<?xml version="1.0" encoding="utf-8"?>
<!--
  miniCar 설정 파일 (miniCar.exe 와 같은 폴더의 miniCar.exe.config)

  - 값을 고치고 저장한 뒤 트레이 메뉴 "설정 다시 불러오기"를 누르면 바로 적용됩니다.
  - 트레이 메뉴에서 바꾼 값(속도 단계, 조작 방식, 디자인, 색상)도 이 파일에 저장됩니다.
    이 설명 주석과 직접 적은 값의 형식은 그대로 유지됩니다.
  - 항목을 지우면 기본값이 쓰이고, 잘못된 값은 기본값으로 바꾼 뒤 트레이 알림으로 알려 줍니다.
  - 파일을 통째로 지우면 다음 실행 때 기본값과 이 설명이 담긴 파일을 다시 만듭니다.
    XML 형식을 깨뜨려 실행이 안 될 때도 이 파일을 지우면 됩니다.
  - 숫자는 소수점에 점(.)을 씁니다. 목록은 쉼표(,)로 구분합니다.

  단축키 쓰는 법: Ctrl, Alt, Shift, Win 중 원하는 것과 키 하나를 + 로 잇습니다.
    키 이름 예: A~Z, 0~9, F1~F12, PageUp, PageDown, Home, End, Insert, Delete,
                Up, Down, Left, Right, Escape(Esc), Space, Enter, Plus, Minus
    예: Ctrl+Alt+F9, Win+Shift+C
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- WinForms(트레이 메뉴 등)도 모니터별 DPI에 맞춰 그리도록. 바꾸지 마세요. -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>

  <appSettings>

    <!-- ═════════════ 전역 단축키 (어떤 앱을 쓰고 있어도 동작) ═════════════ -->

    <!-- 멈추기 / 다시 움직이기 -->
    <add key="TogglePause" value="Ctrl+Alt+Shift+P" />
    <!-- 자율 주행 ↔ 수동 주행 전환 -->
    <add key="ToggleMode" value="Ctrl+Alt+Shift+M" />
    <!-- 속도 단계 올리기 / 내리기 (누르고 있으면 반복) -->
    <add key="SpeedUp" value="Ctrl+Alt+Shift+PageUp" />
    <add key="SpeedDown" value="Ctrl+Alt+Shift+PageDown" />
    <!-- 종료 -->
    <add key="Quit" value="Ctrl+Alt+Shift+Q" />
    <!-- 숨기기 / 다시 보이기. 숨기면 차와 트랙이 모두 사라지고, 트레이 아이콘만 남아 이 키만 기다립니다
         (다른 단축키와 키보드 캡처는 모두 꺼짐). 다시 누르면 숨기기 전 상태(수동 주행 포함)로 돌아옵니다 -->
    <add key="HideToggle" value="Ctrl+Alt+Shift+V" />
    <!-- 트랙 그리기 시작 / 끝내기. 그리는 동안: 왼쪽 버튼 끌기 = 선 그리기, 오른쪽 클릭 = 선 지우기,
         Ctrl+Z = 마지막 선 되돌리기, Esc = 끝내기 (그리는 동안 차는 멈춤) -->
    <add key="TrackEditToggle" value="Ctrl+Alt+Shift+T" />

    <!-- ═════════════ 수동 주행 중에만 쓰는 키 ═════════════
         수동 주행 중에만 동작하므로 다른 프로그램 단축키와 겹쳐도 됩니다. 방향키와 Space는 피하세요. -->

    <!-- 자율 주행으로 돌아가는 키 -->
    <add key="ManualExitKey" value="Escape" />
    <!-- 주차 / 주차 해제 키. 멈춘 상태에서 누르면 주차 → 방향키로 차 아래 창을 옮기거나(최대화된 창은 스크롤) -->
    <add key="ParkKey" value="P" />
    <!-- 수동 주행 중 차가 멈춰 있을 때 키보드를 돌려주기까지의 시간 (초, 0~60).
         - Space: 차가 멈춰 있으면(주차 중 포함) 바로 원래 앱으로 보냄 (멈춘 차에는 브레이크가 필요 없으므로)
         - 헤드라이트 키(H), 주차 키(P) 같은 단독 글자 키: 멈춘 뒤 이 시간이 지나면 원래 앱으로 보냄
           (주차 중에는 P로 주차를 풀 수 있도록 P는 계속 받음)
         - 방향키(다시 출발)와 수동 주행 종료 키(Esc)는 계속 받음
         0이면 단독 글자 키를 멈춘 동안에도 항상 받음 (이전 동작) -->
    <add key="ManualIdleSeconds" value="3" />

    <!-- ═════════════ 속도 ═════════════ -->

    <!-- 속도 단계 목록 (화면 배율 100% 기준 px/초, 쉼표로 구분, 5~5000).
         자율 주행 속도이자 수동 주행의 기본 최고 속도입니다. -->
    <add key="SpeedLevels" value="60,100,150,220,300,420,560" />
    <!-- 현재 속도 단계 (0부터 셈: 0 = 첫 번째 값). 단축키로 바꾸면 자동 저장됩니다. -->
    <add key="SpeedIndex" value="2" />

    <!-- ═════════════ 자율 주행 ═════════════ -->

    <!-- 화면 끝에서 튕길 때 반사각에 더하는 무작위 각도 (±도, 0~30). 0이면 정확한 반사각 -->
    <add key="BounceJitterDegrees" value="8" />
    <!-- 벽에 닿기 전에 드리프트하며 방향을 바꿈 (true / false). false면 벽에 닿는 순간 반사 -->
    <add key="AutoDrift" value="true" />
    <!-- 드리프트 중 진행 방향이 도는 속도 (°/초, 60~720). 클수록 벽 가까이에서 짧고 급하게 돎 -->
    <add key="DriftTurnDegreesPerSecond" value="240" />
    <!-- 드리프트 중 차체가 진행 방향보다 더 돌아가는 최대 각도 (°, 0~70). 클수록 뒤가 많이 미끄러짐. 0이면 미끄러짐 없이 돎 -->
    <add key="DriftSlipDegrees" value="35" />
    <!-- 드리프트할 때 타이어 자국과 연기 표시 (true / false) -->
    <add key="SkidMarks" value="true" />
    <!-- 타이어 자국이 완전히 사라지기까지 걸리는 시간 (초, 0.2~30) -->
    <add key="SkidMarkFadeSeconds" value="2.5" />

    <!-- ═════════════ 수동 주행 ═════════════ -->

    <!-- 조작 방식 (트레이 메뉴에서 바꾸면 자동 저장)
           Car     : 자동차식. ↑ 가속, ↓ 브레이크/후진, ←→ 핸들
           TopDown : 탑뷰 게임식. 방향키 = 화면 방향, 16방향
                     (한 방향을 누른 채 옆 방향키를 톡 치면 22.5°씩 꺾임, 같이 누르면 대각선) -->
    <add key="ManualControlStyle" value="Car" />
    <!-- 자동차식: 핸들을 끝까지 돌렸을 때 초당 회전 각도 (30~1080) -->
    <add key="SteeringDegreesPerSecond" value="200" />
    <!-- 정지 → 기본 최고 속도까지 걸리는 시간 (초, 0.05~30) -->
    <add key="ManualAccelSeconds" value="1.5" />
    <!-- 가속 키를 놓았을 때 기본 최고 속도 → 정지까지 걸리는 시간 (초, 0.05~60). 클수록 관성으로 오래 미끄러짐 -->
    <add key="ManualCoastSeconds" value="2.5" />
    <!-- Space 브레이크로 기본 최고 속도 → 정지까지 걸리는 시간 (초, 0.05~10) -->
    <add key="ManualBrakeSeconds" value="0.35" />
    <!-- 부스트 단계별 최고 속도 배율 (쉼표로 구분, 최대 10단계, 1.0~20.0).
         가속 키를 계속 누르면 단계가 올라가며 배기 불꽃이 나옵니다 (불꽃 세기: 1~2단 / 3~4단 / 5~7단 / 8~10단).
         빈 값("")이면 부스트 끔 -->
    <add key="ManualBoostMultipliers" value="1.4,1.8,2.3,2.8,3.4,4,4.7,5.4,6.2,7" />
    <!-- 현재 단계 최고 속도에서 가속 키를 이만큼 더 누르고 있으면 다음 부스트 단계로 (초, 0.1~10) -->
    <add key="ManualBoostHoldSeconds" value="1.0" />
    <!-- 부스트 중(부스트 1단 이상) 방향을 바꾸면 드리프트 (true / false).
         자동차식: 핸들을 꺾으면 차체가 꺾는 쪽으로 더 돌아가며 뒤가 미끄러짐
         탑뷰: 다른 방향키를 누르면 차체가 먼저 그쪽을 향하고 진행 방향은 미끄러지며 따라감
         미끄러지는 정도는 DriftSlipDegrees, 타이어 자국·연기는 SkidMarks 설정을 따름 -->
    <add key="BoostDrift" value="true" />
    <!-- 연타 부스터 (true / false). 전진 키(자동차식 ↑, 탑뷰는 진행 방향 방향키)를 연달아 누르면
         두 번째부터 누를 때마다 부스터가 한 단계씩 올라갑니다.
         - 멈춘 상태: 두 번 = 1단, 세 번 = 2단 ... 으로 출발
         - 달리는 중: 지금 단계에 더함. 예) 2단으로 달리다 세 번 연타 → 4단 (최대 단계까지)
         마지막에 누른 키를 계속 누르고 있으면 그 단계 최고 속도까지 빠르게 가속하고,
         이후에는 평소처럼 계속 누르면 단계가 더 올라갑니다 -->
    <add key="LaunchTapBoost" value="true" />
    <!-- 연타로 인정하는 누름 간격 (초, 0.1~1.0). 이 시간 안에 다시 눌러야 연타로 셈 -->
    <add key="LaunchTapSeconds" value="0.35" />
    <!-- 수동 주행 중 달리다가 브레이크(Space, 자동차식은 전진 중 ↓)를 밟으면 멈출 때까지 타이어 자국 (true / false).
         SkidMarks가 false면 표시하지 않음 -->
    <add key="BrakeSkidMarks" value="true" />
    <!-- 브레이크 슬라이드 (true / false). 수동 주행 중 달리면서 브레이크(Space)와 방향키를 같이 누르면
         차체가 그쪽으로 돌아가며 옆으로 미끄러집니다 (타이어 자국·연기는 SkidMarks 설정을 따름).
         자동차식: Space + ←/→ (전진 중)   탑뷰: Space + 진행 방향과 다른 방향키
         Space를 떼면 바퀴가 다시 잡히며 차체 방향으로 이어서 달리고, 그대로 멈추면 돌아간 방향으로 섭니다 -->
    <add key="BrakeSlide" value="true" />
    <!-- 브레이크 슬라이드 때 차체가 진행 방향에서 최대로 돌아가는 각도 (°, 10~90). 90이면 완전히 옆으로 -->
    <add key="BrakeSlideDegrees" value="75" />

    <!-- ═════════════ 주차 / 창 이동 ═════════════ -->

    <!-- 주차 중 방향키로 창을 옮기는 최고 속도 (화면 배율 100% 기준 px/초, 50~5000). 누르고 있으면 0.5초에 걸쳐 빨라짐 -->
    <add key="WindowMoveSpeed" value="800" />
    <!-- 주차 중 최대화된 창을 스크롤할 때, 누르고 있으면 초당 최대 휠 칸 수 (1~60) -->
    <add key="ScrollNotchesPerSecond" value="14" />
    <!-- 스크롤 방식
           Input   : 차 위치에서 실제 마우스 휠 입력 (커서를 잠깐 옮겼다 되돌림, 대부분의 앱에서 동작)
           Message : 차 아래 창에 휠 메시지를 직접 보냄 (커서 안 움직임, 무시하는 앱이 많음) -->
    <add key="ScrollMethod" value="Input" />
    <!-- 창을 옮길 때 주차된 차도 창과 함께 이동 (true / false) -->
    <add key="ParkCarFollowsWindow" value="true" />

    <!-- ═════════════ 외형 ═════════════ -->

    <!-- 차 디자인: GT (긴 보닛, 검은 루프) / Classic (레이싱 스트라이프). 트레이 메뉴에서 바꾸면 자동 저장 -->
    <add key="CarDesign" value="GT" />
    <!-- 차체 색 (HTML 색 코드). 트레이 메뉴 프리셋:
           레드 #E53935, 실버 블루 #8DA2B8, 딥 블루 #1F3F9E, 옐로 #F2C230,
           그린 #2E8B57, 오렌지 #F2711C, 화이트 #ECEFF1, 블랙 #2B2D31 -->
    <add key="CarColor" value="#E53935" />
    <!-- 차 길이 (화면 배율 100% 기준 px, 16~300) -->
    <add key="CarLength" value="48" />

    <!-- ═════════════ 트랙 ═════════════
         마우스로 그린 선은 벽처럼 작용합니다 (자율 주행은 튕겨 나가고, 수동 주행은 부딪혀 미끄러짐).
         트랙은 exe 옆 tracks 폴더에 "이름.track"으로 저장됩니다 (트레이 메뉴 → 트랙). -->

    <!-- 새로 그리는 선 굵기 (화면 배율 100% 기준 px, 2~40). 이미 그린 선은 그대로 -->
    <add key="TrackWidth" value="8" />
    <!-- 자율 주행에서 트랙이 있으면 트랙을 따라 달림 (true / false).
         차에서 가장 가까운 선 옆을 따라 달리고, 닫힌 선은 차가 있는 쪽(안쪽/바깥쪽)을 계속 돌며,
         열린 선은 끝에서 U턴해 반대쪽 옆으로 돌아옵니다. 다른 선이나 화면 끝에 막히면 되돌아갑니다.
         false면 트랙이 있어도 화면 전체를 돌아다니고, 선에 닿으면 튕겨 나갑니다 -->
    <add key="AutoFollowTrack" value="true" />
    <!-- 트랙을 따라 달리다 방향이 크게 바뀌는 곳(모서리, 선 끝 U턴)에서 부스터를 켜고 드리프트 (true / false).
         꺾이는 각도에 따라 부스터 1~3단, 타이어 자국·연기는 SkidMarks 설정을 따름 -->
    <add key="TrackBoostDrift" value="true" />
    <!-- 선 가운데 색 (HTML 색 코드). 바깥에 어두운 테두리가 함께 그려져 밝은 바탕·어두운 바탕 모두에서 보입니다 -->
    <add key="TrackColor" value="#FFB300" />
    <!-- 마지막으로 불러오거나 저장한 트랙 이름. 시작할 때 이 트랙을 불러옵니다 (빈 값 = 트랙 없이 시작) -->
    <add key="TrackName" value="" />

    <!-- ═════════════ 동작 ═════════════ -->

    <!-- true: 작업표시줄을 벽으로 취급 / false: 작업표시줄 위로도 다님 -->
    <add key="UseWorkArea" value="true" />
    <!-- 전체 화면일 때 자동으로 숨기기 (트레이 메뉴 → 전체 화면일 때 숨기기 에서도 바꿀 수 있음)
           Games : 게임(DirectX 전체 화면), PPT 슬라이드쇼, 잠금 화면에서만 숨김 (기본)
                   브라우저·Claude 같은 일반 앱의 전체 화면(F11 등)에서는 그대로 달림
           All   : 위 경우 + 일반 앱이 전체 화면일 때도 숨김 (동영상 전체 화면 등)
           Never : 숨기지 않음
         최대화한 창(작업 표시줄 자동 숨기기로 화면을 다 채우는 경우 포함)은 어느 경우에도 전체 화면으로 보지 않습니다 -->
    <add key="HideOnFullscreen" value="Games" />
    <!-- 수동 주행 중 차 위에 키 안내 팝업 표시 (true / false, 기본 false).
         실행 중에는 차를 마우스로 클릭할 때마다 켜고 끌 수 있고, 바꾼 값은 여기에 저장됩니다 -->
    <add key="ShowKeyGuide" value="false" />
    <!-- 차 아래에 부스트 단계·속도·속도 막대 표시 (true / false). 트레이 메뉴 "속도 표시"로도 켜고 끔 -->
    <add key="ShowSpeedHud" value="true" />
    <!-- 헤드라이트 켜짐 (true / false). 켜고 끈 상태가 여기에 저장됩니다 -->
    <add key="Headlights" value="false" />
    <!-- 헤드라이트 켜기/끄기 키 (수동 주행 중, 수식키 없이). 자율 주행 중에는 키보드를 가져가지 않으므로
         이 키는 수동 주행 중에만 동작합니다 (단독 키를 전역으로 잡으면 모든 앱에서 그 글자를 칠 수 없게 됨) -->
    <add key="HeadlightKey" value="H" />
    <!-- 헤드라이트 켜기/끄기 전역 단축키 (자율·수동 어느 모드에서나 동작) -->
    <add key="HeadlightToggle" value="Ctrl+Alt+Shift+H" />

  </appSettings>
</configuration>
