<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows에 기본 내장된 .NET Framework 4.8을 대상으로 한다 (별도 런타임 설치 불필요).
    언어는 최신 C#을 사용하고, 부족한 API는 Polyfills.cs에서 보충한다.
    Windows에서 빌드: dotnet build -c Release  (또는 Visual Studio)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>miniCar</RootNamespace>
    <AssemblyName>miniCar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>miniCar.ico</ApplicationIcon>
    <Version>1.6.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Xml" />
    <!-- 설정 파일(설명 주석 포함)을 exe에도 넣어 둔다: miniCar.exe.config가 없으면 이것으로 다시 만든다 -->
    <EmbeddedResource Include="App.config" LogicalName="miniCar.App.config" />
  </ItemGroup>

</Project>
