: "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1374389013, "version": 1, "versionNonce": 1477816547, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "트랙 선", "originalText": "트랙 선", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0062", "type": "text", "x": 1196, "y": 747.5, "width": 711.77, "height": 21.25, "angle": 0, "strokeColor": "#6b7480", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1196040477, "version": 1, "versionNonce": 471619988, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "마우스로 그린 선. 자율 주행은 트랙 주변을 따라 달리고, 수동 주행에서는 벽(부딪히거나 따라 미끄러짐)", "originalText": "마우스로 그린 선. 자율 주행은 트랙 주변을 따라 달리고, 수동 주행에서는 벽(부딪히거나 따라 미끄러짐)", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0063", "type": "ellipse", "x": 1150, "y": 784.75, "width": 34, "height": 34, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "#3b6fd8", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1470197912, "version": 1, "versionNonce": 696391872, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false}, {"id": "el0064", "type": "text", "x": 1150, "y": 788.75, "width": 34, "height": 25.0, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1810010707, "version": 1, "versionNonce": 1649940839, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "8", "originalText": "8", "fontSize": 20, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "autoResize": false, "lineHeight": 1.25}, {"id": "el0065", "type": "text", "x": 1196, "y": 785.75, "width": 90.94, "height": 27.5, "angle": 0, "strokeColor": "#3b6fd8", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1666447133, "version": 1, "versionNonce": 120125831, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "다른 앱 위", "originalText": "다른 앱 위", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0066", "type": "text", "x": 1196, "y": 816.75, "width": 504.05, "height": 21.25, "angle": 0, "strokeColor": "#6b7480", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 491876989, "version": 1, "versionNonce": 1764807638, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "항상 맨 위에 떠 있지만 포커스를 가져가지 않고, 빈 곳 클릭은 아래 창으로", "originalText": "항상 맨 위에 떠 있지만 포커스를 가져가지 않고, 빈 곳 클릭은 아래 창으로", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0067", "type": "ellipse", "x": 1150, "y": 854.0, "width": 34, "height": 34, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "#2e9e5b", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 68934738, "version": 1, "versionNonce": 1728822696, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false}, {"id": "el0068", "type": "text", "x": 1150, "y": 858.0, "width": 34, "height": 25.0, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 677430271, "version": 1, "versionNonce": 861494830, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "9", "originalText": "9", "fontSize": 20, "fontFamily": 2, "textAlign": "center", "verticalAlign": "top", "containerId": null, "autoResize": false, "lineHeight": 1.25}, {"id": "el0069", "type": "text", "x": 1196, "y": 855.0, "width": 126.41, "height": 27.5, "angle": 0, "strokeColor": "#2e9e5b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 574969168, "version": 1, "versionNonce": 142138945, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "트레이 아이콘", "originalText": "트레이 아이콘", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0070", "type": "text", "x": 1196, "y": 886.0, "width": 438.19, "height": 21.25, "angle": 0, "strokeColor": "#6b7480", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 453082199, "version": 1, "versionNonce": 1960944881, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "우클릭 메뉴(모든 기능), 더블클릭 = 