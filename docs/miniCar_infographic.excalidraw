le": 0, "strokeColor": "#e53935", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2055823970, "version": 1, "versionNonce": 1568748220, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "브레이크 슬라이드", "originalText": "브레이크 슬라이드", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0215", "type": "text", "x": 1036.0, "y": 2414.5, "width": 404.2, "height": 42.5, "angle": 0, "strokeColor": "#2f3744", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2137653951, "version": 1, "versionNonce": 1682256072, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "달리며 Space + 방향키 → 최대 75° 옆으로 미끄러짐. 떼면\n다시 잡힘", "originalText": "달리며 Space + 방향키 → 최대 75° 옆으로 미끄러짐. 떼면\n다시 잡힘", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0216", "type": "rectangle", "x": 1488.0, "y": 2364.5, "width": 452.0, "height": 128, "angle": 0, "strokeColor": "#2e9e5b", "backgroundColor": "#e6f5ec", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1193503387, "version": 1, "versionNonce": 1421357809, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false}, {"id": "el0217", "type": "text", "x": 1512.0, "y": 2378.5, "width": 139.44, "height": 27.5, "angle": 0, "strokeColor": "#2e9e5b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "soli