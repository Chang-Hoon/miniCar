"type": "rectangle", "x": 1012.0, "y": 2216.5, "width": 452.0, "height": 128, "angle": 0, "strokeColor": "#e53935", "backgroundColor": "#fdecea", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1989357941, "version": 1, "versionNonce": 1618269593, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false}, {"id": "el0202", "type": "text", "x": 1036.0, "y": 2230.5, "width": 187.94, "height": 27.5, "angle": 0, "strokeColor": "#e53935", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1822560211, "version": 1, "versionNonce": 507621089, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "가속·관성·브레이크", "originalText": "가속·관성·브레이크", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0203", "type": "text", "x": 1036.0, "y": 2266.5, "width": 345.88, "height": 42.5, "angle": 0, "strokeColor": "#2f3744", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 357150386, "version": 1, "versionNonce": 872767550, "isDeleted": false, "boundElements": [], "updated": 1795588177001, "link": null, "locked": false, "text": "누르면 서서히 가속, 놓으면 관성으로 정지. Space\n브레이크, 빠르면 타이어 자국", "originalText": "누르면 서서히 가속, 놓으면 관성으로 정지. Space\n브레이크, 빠르면 타이어 자국", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "el0204", "type": "rectangle", "x": 1488.0, "y": 2216.5, "width": 452.0, "height": 128, "angle": 0, "strokeColor": "#e53935", "bac